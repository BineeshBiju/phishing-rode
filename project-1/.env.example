# CyberScape Security Configuration Example
CYBERSCAPE_SECRET_KEY=change-this-in-production-to-a-secure-random-key
PORT=5000
HOST=127.0.0.1
DEBUG=True

# Live Threat Intelligence API Keys (Optional - falls back to public feeds and heuristics)
# VirusTotal v3 API Key (https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing API v4 Key (https://developers.google.com/safe-browsing/v4)
GOOGLE_SAFEBROWSING_API_KEY=your_google_safebrowsing_key_here

# URLhaus API Key (Optional - public endpoint works without key)
URLHAUS_API_KEY=

# Geolocation & Network Intelligence (Optional - falls back to free HTTPS endpoints)
# ipinfo.io API Token (Optional, 50k requests/month free: https://ipinfo.io/)
IPINFO_TOKEN=

# AbuseIPDB API Key (Optional, 1k checks/day free: https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY=

# Local MaxMind GeoLite2 Database Directory (Optional - offline MMDB lookup without network)
# Path to directory containing GeoLite2-City.mmdb and GeoLite2-ASN.mmdb
GEOLITE2_DB_PATH=

